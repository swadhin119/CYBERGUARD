# =========================================================
# CyberGuard Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =========================================================

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME="CyberGuard API"
APP_VERSION="2.0.0"
DEBUG=false

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
RELOAD=false

# ------------------------------------------------------------------
# CORS
# Comma-separated origins. Use "*" for local dev only.
# In production, set explicit origins, e.g.:
#   CORS_ORIGINS=https://cyberguard.example.com,https://admin.example.com
# ------------------------------------------------------------------
CORS_ORIGINS=*

# ------------------------------------------------------------------
# Authentication (CHANGE THIS IN PRODUCTION)
# Generate a strong random key:  openssl rand -hex 32
# ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-strong-random-value-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------
# Database
# SQLite for local development.
# PostgreSQL for production, e.g.:
#   postgresql://cyberguard:password@db.example.com:5432/cyberguard
# ------------------------------------------------------------------
DATABASE_URL=sqlite:///./cyberguard.db

# ------------------------------------------------------------------
# Analysis limits
# ------------------------------------------------------------------
MAX_EMAIL_BODY_LENGTH=10000
MAX_QR_CONTENT_LENGTH=10000
MAX_URL_LENGTH=2048
MAX_SOCIAL_USERNAME_LENGTH=100
MAX_DISPLAY_NAME_LENGTH=200
MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------------
# Optional Threat Intelligence API Keys
# Leave blank to use local analysis engines only.
# ------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=

# ------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_ANALYSIS=20/minute
